FROM python:3.9-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    kafka-python==2.0.2 \
    pandas==2.0.3 \
    numpy==1.24.3

# Copy producer script
COPY src/streaming/kafka_producer.py .

# Create data directory
RUN mkdir -p /app/data

CMD ["python", "kafka_producer.py"]